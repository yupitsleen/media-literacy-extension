{
  "name": "media-literacy-extension",
  "version": "1.0.0",
  "description": "A browser extension for detecting logical fallacies, hypocrisy, and campaign finance connections in web content.",
  "main": "src/background/service-worker.js",
  "scripts": {
    "dev": "webpack --mode development --watch",
    "build": "webpack --mode production",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "validate": "npm run lint && npm test",
    "prepare": "husky"
  },
  "keywords": [
    "browser-extension",
    "media-literacy",
    "logical-fallacies",
    "critical-thinking"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "eslint": "^8.0.0",
    "husky": "^9.1.7",
    "jest": "^29.0.0",
    "lint-staged": "^16.1.6",
    "webpack": "^5.0.0",
    "webpack-cli": "^5.0.0"
  },
  "lint-staged": {
    "src/**/*.js": [
      "eslint --fix",
      "jest --findRelatedTests --passWithNoTests"
    ]
  }
}
