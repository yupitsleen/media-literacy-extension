#!/bin/sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Running pre-commit checks..."

# Run lint-staged for changed files
npx lint-staged

# Run all tests to catch any breaking changes
echo "🧪 Running all tests..."
npm test

# Run linting on entire src directory
echo "🧹 Running full linting..."
npm run lint

echo "✅ Pre-commit checks passed!"
